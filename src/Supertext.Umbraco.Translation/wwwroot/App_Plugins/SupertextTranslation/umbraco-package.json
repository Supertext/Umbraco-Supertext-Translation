{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Supertext Translation",
  "id": "Supertext.Umbraco.Translation",
  "version": "0.1.0",
  "allowTelemetry": true,
  "extensions": [
    {
      "type": "localization",
      "alias": "Supertext.Localization.EN",
      "name": "Supertext English UI localization",
      "meta": {
        "culture": "en"
      },
      "js": "/App_Plugins/SupertextTranslation/lang/en.js"
    },
    {
      "type": "localization",
      "alias": "Supertext.Localization.DE",
      "name": "Supertext German UI localization",
      "meta": {
        "culture": "de"
      },
      "js": "/App_Plugins/SupertextTranslation/lang/de.js"
    },
    {
      "type": "localization",
      "alias": "Supertext.Localization.FR",
      "name": "Supertext French UI localization",
      "meta": {
        "culture": "fr"
      },
      "js": "/App_Plugins/SupertextTranslation/lang/fr.js"
    },
    {
      "type": "localization",
      "alias": "Supertext.Localization.IT",
      "name": "Supertext Italian UI localization",
      "meta": {
        "culture": "it"
      },
      "js": "/App_Plugins/SupertextTranslation/lang/it.js"
    },
    {
      "type": "workspaceAction",
      "kind": "default",
      "alias": "Supertext.WorkspaceAction.Translate",
      "name": "Translate with Supertext (workspace button)",
      "api": "/App_Plugins/SupertextTranslation/workspace-action.js",
      "weight": 50,
      "meta": {
        "label": "#supertext_translateWithSupertext",
        "look": "secondary"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "match": "Umb.Workspace.Document"
        }
      ]
    },
    {
      "type": "entityAction",
      "kind": "default",
      "alias": "Supertext.EntityAction.Translate",
      "name": "Translate with Supertext (document actions)",
      "api": "/App_Plugins/SupertextTranslation/entity-action.js",
      "forEntityTypes": [
        "document"
      ],
      "weight": 650,
      "meta": {
        "icon": "icon-globe",
        "label": "#supertext_translateWithSupertext"
      }
    },
    {
      "type": "modal",
      "alias": "Supertext.Modal.Translate",
      "name": "Translate with Supertext dialog",
      "element": "/App_Plugins/SupertextTranslation/translate-modal.js"
    }
  ]
}
