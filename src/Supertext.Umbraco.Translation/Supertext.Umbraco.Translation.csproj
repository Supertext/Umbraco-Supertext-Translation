<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Supertext.Umbraco.Translation</RootNamespace>
    <PackageId>Supertext.Umbraco.Translation</PackageId>
    <Version>0.1.0</Version>
    <Title>Supertext Translation for Umbraco</Title>
    <Description>Translate Umbraco documents into other languages with Supertext AI, from a "Translate with Supertext" action in the backoffice.</Description>
    <Authors>Supertext AG</Authors>
    <PackageTags>umbraco;umbraco-marketplace;translation;supertext</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Supertext/Umbraco-Supertext-Translation</RepositoryUrl>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0, 19.0.0)" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Supertext.Umbraco.Translation.Tests" />
  </ItemGroup>
</Project>
