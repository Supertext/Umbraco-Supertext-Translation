# Variables for the Umbraco demo container (set them as Railway service variables).
# Never commit real values.

# Demo accounts. DEMO_ADMIN_* is required on first boot (unattended install); both are
# created on every start if missing. Umbraco requires passwords of at least 10 characters.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext. No account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate the API key at https://www.supertext.com/en/integrations/api
# (supertext.com -> Integrations -> API; requires the Admin role).
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/
# Optional: another review service for languages with "Translation review" ticked on
# Settings › Supertext (default: Supertext's review service)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/
# "Send version information to Supertext" (on by default): 0 turns the version reports
# (site URL, package/Umbraco/.NET/SDK versions, API key check result) and the ping route off.
# SUPERTEXT_VERSION_REPORTS=0

# Public URL of the demo (the backoffice login needs it). On Railway it defaults to
# https://$RAILWAY_PUBLIC_DOMAIN.
# APP_URL=https://umbraco-demo.example.com

# Railway: port Kestrel listens on (match the domain's target port)
PORT=8080
