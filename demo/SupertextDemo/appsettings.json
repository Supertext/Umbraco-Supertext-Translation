{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "ab2b2760-e897-406d-998a-4adc12a8fdfa"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "PackageMigrationsUnattended": true,
        "UnattendedUserName": "Demo Administrator",
        "UnattendedTelemetryLevel": "Minimal"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "F8hpceXtl6k5LgyY18G92261Wotooj+sabVimo1tDRTE8eF60iIhnWhU2jeR8iXOK0zj2D1UoRV08RQqxERmxg=="
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Supertext": {
    "Endpoint": "https://api.supertext.com/v1/",
    "Languages": {
      "de-CH": {
        "Code": "de-CH",
        "Politeness": "more"
      },
      "fr-CH": {
        "Code": "fr-CH",
        "Politeness": "more"
      },
      "it-CH": {
        "Code": "it-CH",
        "Politeness": "more"
      }
    },
    "ExcludedProperties": [
      "code"
    ]
  }
}
