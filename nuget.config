<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget/ holds Supertext.Sdk (https://github.com/Supertext/Supertext-API-SDK-and-Guide), packed from
    the SDK repository until it is published on nuget.org. See docs/DEVELOPER.md -> Supertext SDK.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="supertext-local" value="nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="supertext-local">
      <package pattern="Supertext.Sdk" />
    </packageSource>
  </packageSourceMapping>
</configuration>
